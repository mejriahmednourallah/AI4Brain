NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-local-password
AI4BRAIN_DB=data/ai4brain.sqlite3
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
NEO4J_ENABLED=false

# Docker Compose uses a separate named-volume database, not AI4BRAIN_DB above.
AI4BRAIN_HTTP_PORT=8080
AI4BRAIN_NEO4J_HTTP_PORT=7475
AI4BRAIN_NEO4J_BOLT_PORT=7688
AI4BRAIN_CPU_THREADS=2
# Optional server-side coaching; local mode remains the default until learner opt-in.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
